# Copy to .env for local development. Never commit .env.

# Long random string. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True locally, False in production.
DEBUG=True

# Leave empty to use local SQLite.
# Supabase migrations from your machine: Session pooler (port 5432).
# Vercel runtime: Transaction pooler (port 6543).
DATABASE_URL=

# Password reset sends email through any SMTP provider. Leave EMAIL_HOST empty to switch the feature off
# in production (locally, with DEBUG=True, emails are printed to the terminal instead).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Shown as the sender, e.g. Kararsızım <adres@ornek.com>. Defaults to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
